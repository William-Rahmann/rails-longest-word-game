<h1>Games#new</h1>

<% @letters.each do |letter| %>
  <span class = "badge bg-primary"><%= letter%></span>
<% end%>

<p>What's the longest word you can find?</p>

<%= form_tag(score_path, method: :post, data: { turbo: false }) do %>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= hidden_field_tag :letters, @letters.join %>
  <%= text_field_tag :word %>
  <%= submit_tag "Play" %>
<% end%>
